# Required. The ranking model. https://console.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Recommended. One-sentence summary + page kind for every candidate. https://openrouter.ai/keys
# Without it, Jev ranks on titles alone and nothing is filtered out.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional. Raises the r.jina.ai rate limit used to read pages. https://jina.ai/reader
JINA_API_KEY=

# Feed language: en or zh. The UI and every generated summary follow it.
JEVFEED_LANG=en
JEVFEED_PORT=3050
